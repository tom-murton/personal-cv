{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    { "source": "/home", "destination": "/", "permanent": true },
    { "source": "/about", "destination": "/#about", "permanent": true },
    { "source": "/work", "destination": "/cv", "permanent": true },
    { "source": "/experience", "destination": "/cv", "permanent": true },
    { "source": "/articles", "destination": "/writing", "permanent": true },
    {
      "source": "/instagram",
      "destination": "https://www.instagram.com/tom.murton",
      "permanent": false
    }
  ],
  "rewrites": [
    { "source": "/projects", "destination": "/projects/index.html" },
    { "source": "/projects/ship-a-game", "destination": "/projects/ship-a-game/index.html" },
    { "source": "/projects/ship-a-game/:game", "destination": "/projects/ship-a-game/:game/index.html" },
    { "source": "/writing", "destination": "/writing/index.html" },
    { "source": "/writing/:slug", "destination": "/writing/:slug/index.html" },
    { "source": "/talks", "destination": "/talks/index.html" },
    { "source": "/cv", "destination": "/cv/index.html" },
    { "source": "/admin", "destination": "/admin/index.html" },
    { "source": "/designs", "destination": "/designs/index.html" },
    { "source": "/designs/:slug", "destination": "/designs/:slug/index.html" }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    },
    {
      "source": "/registerSW.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ]
}
