    {
      "source": "/projects",
      "destination": "/projects/index.html"
    },
    {
      "source": "/writing",
      "destination": "/writing/index.html"
    },
    {
      "source": "/writing/:slug",
      "destination": "/writing/:slug/index.html"
    },
    {
      "source": "/talks",
      "destination": "/talks/index.html"
    },
    {
